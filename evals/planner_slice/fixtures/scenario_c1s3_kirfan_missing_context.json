  "user_message": "Spin up a small statblock for Kirfan from the StoneBridge flood beats?",
  "statblock_stub": null,
  "mock_responses": [
    {
      "id": "resp-kirfan-1",
      "output": [
        {
          "type": "function_call",
          "name": "recall_npc_context",
          "call_id": "fc-kirfan-recall",
          "arguments": "{\"campaign_id\": \"longmont-c1\", \"npc\": \"Kirfan\", \"max_chars_per_file\": 4000}"
        }
      ]
    },
    {
      "id": "resp-kirfan-2",
      "output": [
        {
          "type": "message",
          "content": [
            {
              "type": "output_text",
