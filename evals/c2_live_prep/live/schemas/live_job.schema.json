{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "live_job.schema.json",
  "title": "C2 Live Play Job Row v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "created_at",
    "job_type",
    "status",
    "payload",
    "created_from_event_id",
    "dependencies",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1\\.\\d+$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "append_staging",
        "benchmark_candidate",
        "post_session_propagation",
        "packet_rebuild",
        "recap_input",
        "manual_review"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "in_progress",
        "blocked",
        "complete",
        "cancelled"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "created_from_event_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_paths",
        "generated_by"
      ],
      "properties": {
        "source_paths": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "role"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "generated_by": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
