{
  "schema": "unsure_queue_v1",
  "mode": "exact",
  "expected_items": [
    {
      "id": "tower_blueprint_placement",
      "question_must_match": "(?i)tower.{0,40}(blueprint|location|placement)",
      "default_must_mention": "Locations",
      "alternatives_min_count": 3
    },
    {
      "id": "mayor_sheriff_names",
      "question_must_match": "(?i)(mayor|sheriff).{0,80}(name|slug|canonical)",
      "default_must_mention": "stub",
      "alternatives_min_count": 2
    },
    {
      "id": "stuart_surname",
      "question_must_match": "(?i)stuart.{0,40}(surname|family|name)",
      "default_must_mention": "stuart",
      "alternatives_min_count": 2
    }
  ],
  "max_total_items": 4,
  "min_total_items": 2,
  "_example_shape_mode": {
    "_comment": "Shape-mode example (grader ignores keys prefixed with _). Use this pattern for perturbation scenarios that should not require exact IDs but should enforce structural hygiene.",
    "mode": "shape",
    "min_total_items": 2,
    "max_total_items": 4,
    "per_item_shape": {
      "id_required": true,
      "id_pattern": "^[a-z][a-z0-9_]*$",
      "question_required": true,
      "default_summary_required": true,
      "min_alternatives": 2
    }
  }
}
