{
  "name": "live-control-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "bench:surface": "DMB_BENCH_SURFACE=1 playwright test -c playwright.config.ts",
    "bench:surface:check": "node -e \"if(process.env.DMB_BENCH_SURFACE!=='1'){console.log('surface bench skipped (set DMB_BENCH_SURFACE=1)'); process.exit(0)} process.exit(require('child_process').spawnSync('npx',['playwright','test','-c','playwright.config.ts'],{stdio:'inherit',shell:true,env:process.env}).status||0)\""
  },
  "dependencies": {
    "@tiptap/core": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.2"
  }
}
