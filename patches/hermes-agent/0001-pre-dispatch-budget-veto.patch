diff --git a/tests/agent/test_pre_dispatch_budget_veto.py b/tests/agent/test_pre_dispatch_budget_veto.py
new file mode 100644
index 0000000..9daf11b
--- /dev/null
+++ b/tests/agent/test_pre_dispatch_budget_veto.py
@@ -0,0 +1,514 @@
+"""Terminal request-budget rejection at the common SDK dispatch boundary."""
+
+from __future__ import annotations
+
+import os
+import shutil
+import sys
+import tempfile
+from types import SimpleNamespace
+
+import pytest
+
+
+@pytest.fixture()
+def agent_factory(monkeypatch):
+    home = tempfile.mkdtemp(prefix="hermes_budget_veto_")
+    monkeypatch.setenv("HERMES_HOME", os.path.join(home, ".hermes"))
+    os.makedirs(os.environ["HERMES_HOME"])
+    for mod in list(sys.modules):
+        if mod == "run_agent" or mod.startswith(("agent.", "tools.", "hermes_")):
+            del sys.modules[mod]
+    from run_agent import AIAgent
+
+    def create(
+        *,
+        base_url="http://127.0.0.1:9/v1",
+        provider="openai-api",
+        model="synthetic-model",
+    ):
+        return AIAgent(
+            api_key="synthetic-test-key",
+            base_url=base_url,
+            provider=provider,
+            model=model,
+            max_iterations=4,
+            enabled_toolsets=[],
+            quiet_mode=True,
+            skip_context_files=True,
+            skip_memory=True,
+            save_trajectories=False,
+            platform="cli",
+        )
+
+    yield create
+    shutil.rmtree(home, ignore_errors=True)
+
+
+@pytest.mark.parametrize("streaming_disabled", [False, True])
+def test_budget_veto_is_terminal_before_sdk_fallback_or_streaming(
+    agent_factory, streaming_disabled
+):
+    from agent.api_request_budget import ApiRequestBudgetVeto
+
+    agent = agent_factory()
+    agent._disable_streaming = streaming_disabled
+    agent._api_request_budget_terminal_failure = {
+        "reason": "provider_transport_ambiguous",
+        "transition": "outcome_unknown",
+        "acknowledged": True,
+        "transport_exception_class": "ConnectError",
+    }
+    agent._fallback_chain = [{"provider": "fallback", "model": "synthetic-fallback"}]
+    agent._fallback_index = 0
+    dispatches = []
+    agent._interruptible_streaming_api_call = lambda *_a, **_k: dispatches.append("stream")
+    agent._interruptible_api_call = lambda *_a, **_k: dispatches.append("plain")
+    fallback_calls = []
+    agent._try_activate_fallback = lambda **_k: fallback_calls.append(True) or True
+    views = []
+
+    def veto(view):
+        views.append(view)
+        raise ApiRequestBudgetVeto()
+
+    agent.api_request_budget_guard = veto
+    result = agent.run_conversation("synthetic request", conversation_history=[], task_id="budget-test")
+
+    assert result["failure_code"] == "request_budget_exceeded"
+    assert result["failure_reason"] == "request_budget_veto"
+    assert "failure_diagnostic" not in result
+    assert result["api_request_id"].endswith(":api:1")
+    assert "Earlier provider attempts may have occurred" in result["final_response"]
+    assert views
+    assert views[0].provider == "openai-api"
+    assert views[0].model == "synthetic-model"
+    assert views[0].api_mode == agent.api_mode
+    assert views[0].payload_utf8_bytes > 0
+    assert dispatches == []
+    assert fallback_calls == []
+
+
+def test_final_execution_middleware_request_is_the_budgeted_request(agent_factory):
+    from hermes_cli.plugins import get_plugin_manager
+    from agent.api_request_budget import ApiRequestBudgetVeto
+
+    agent = agent_factory()
+    manager = get_plugin_manager()
+    callbacks = manager._middleware.setdefault("llm_execution", [])
+    seen = []
+
+    def rewrite_request(request, next_call, **_kwargs):
+        rewritten = dict(request)
+        rewritten["messages"] = [{"role": "user", "content": "rewritten-after-preflight"}]
+        return next_call(rewritten)
+
+    callbacks.append(rewrite_request)
+    agent._interruptible_streaming_api_call = lambda *_a, **_k: pytest.fail("stream dispatched")
+    agent._interruptible_api_call = lambda *_a, **_k: pytest.fail("request dispatched")
+
+    def guard(view):
+        seen.append(view)
+        if "rewritten-after-preflight" in view.payload_json:
+            raise ApiRequestBudgetVeto()
+        return True
+
+    agent.api_request_budget_guard = guard
+    try:
+        result = agent.run_conversation("original", conversation_history=[], task_id="budget-middleware")
+    finally:
+        callbacks.remove(rewrite_request)
+
+    assert result["failure_code"] == "request_budget_exceeded"
+    assert len(seen) == 1
+    assert "rewritten-after-preflight" in seen[0].payload_json
+
+
+def test_unconfigured_guard_preserves_legacy_dispatch_path(agent_factory):
+    from agent.api_request_budget import enforce_api_request_budget
+
+    class Agent:
+        provider = "openai-compat"
+        model = "synthetic-model"
+        api_mode = "chat_completions"
+        base_url = "http://localhost/v1"
+
+    enforce_api_request_budget(Agent(), {"model": "synthetic-model", "messages": []})
+
+
+def test_guarded_codex_authorization_includes_stream_and_denial_precedes_sdk(
+    agent_factory,
+):
+    agent = agent_factory(
+        base_url="https://api.openai.com/v1", model="gpt-6-luna"
+    )
+    assert agent.api_mode == "codex_responses"
+    calls = []
+    views = []
+
+    def deny(view):
+        views.append(view)
+        return False
+
+    agent.api_request_budget_guard = deny
+    agent._interruptible_streaming_api_call = lambda *_a, **_k: calls.append("stream")
+    agent._interruptible_api_call = lambda *_a, **_k: calls.append("plain")
+    result = agent.run_conversation(
+        "synthetic request", conversation_history=[], task_id="budget-codex-stream"
+    )
+
+    assert result["failure_code"] == "request_budget_exceeded"
+    assert len(views) == 1
+    assert '"stream":true' in views[0].payload_json
+    assert calls == []
+
+
+def test_guarded_codex_stream_does_not_retry_inside_one_authorization(agent_factory):
+    import httpx
+    from agent.api_request_budget import ApiRequestBudgetVeto
+
+    agent = agent_factory(
+        base_url="https://api.openai.com/v1", model="gpt-6-luna"
+    )
+    assert agent.api_mode == "codex_responses"
+    agent.api_request_budget_guard = lambda _view: True
+    calls = []
+
+    def fail_before_response(**kwargs):
+        calls.append(kwargs)
+        raise httpx.ConnectError("synthetic transport failure")
+
+    client = SimpleNamespace(responses=SimpleNamespace(create=fail_before_response))
+    with pytest.raises(ApiRequestBudgetVeto):
+        agent._run_codex_stream(
+            {"model": "gpt-6-luna", "instructions": "test", "input": []},
+            client=client,
+        )
+
+    assert len(calls) == 1
+    assert calls[0]["stream"] is True
+
+
+def test_guarded_codex_transport_failure_is_unknown_and_never_retried(agent_factory):
+    import httpx
+
+    from agent.api_request_budget import ApiRequestBudgetVeto
+
+    agent = agent_factory(
+        base_url="https://api.openai.com/v1", model="gpt-6-luna"
+    )
+    agent.api_request_budget_guard = lambda _view: True
+    agent._api_request_budget_authorization_sequence = 1
+    lifecycle = []
+    agent.api_provider_lifecycle_callback = (
+        lambda transition: lifecycle.append(transition) or True
+    )
+    calls = []
+
+    def fail_after_dispatch(**_kwargs):
+        calls.append(_kwargs)
+        raise httpx.ConnectError("synthetic ambiguous transport failure")
+
+    client = SimpleNamespace(responses=SimpleNamespace(create=fail_after_dispatch))
+    with pytest.raises(ApiRequestBudgetVeto) as error:
+        agent._run_codex_stream(
+            {"model": "gpt-6-luna", "instructions": "test", "input": []},
+            client=client,
+        )
+
+    assert error.value.code == "provider_lifecycle_unavailable"
+    assert len(calls) == 1
+    assert lifecycle == ["outcome_unknown"]
+    assert calls[0]["stream"] is True
