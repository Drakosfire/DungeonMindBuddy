+@pytest.mark.parametrize(
+    ("acknowledgements", "expected_transition"),
+    [
+        ([False], "sdk_entered"),
+        ([True, False], "response_received"),
+    ],
+)
+def test_guarded_codex_lifecycle_ack_denial_is_reported_without_payload(
+    agent_factory, acknowledgements, expected_transition
+):
+    from agent.api_request_budget import ApiRequestBudgetVeto
+
+    agent = agent_factory(
+        base_url="https://api.openai.com/v1", model="gpt-6-luna"
+    )
+    agent.api_request_budget_guard = lambda _view: True
+    calls = []
+    transitions = []
+    answers = iter(acknowledgements)
+
+    def acknowledge(transition):
+        transitions.append(transition)
+        return next(answers)
+
+    agent.api_provider_lifecycle_callback = acknowledge
+    event_stream = SimpleNamespace(output=[], close=lambda: calls.append("closed"))
+    client = SimpleNamespace(
+        responses=SimpleNamespace(
+            create=lambda **kwargs: calls.append(kwargs) or event_stream
+        )
+    )
+    with pytest.raises(ApiRequestBudgetVeto) as veto:
+        agent._run_codex_stream(
+            {"model": "gpt-6-luna", "instructions": "private prompt", "input": []},
+            client=client,
+        )
+
+    assert veto.value.code == "provider_lifecycle_unavailable"
+    if expected_transition == "sdk_entered":
+        assert transitions == ["sdk_entered", "outcome_unknown"]
+    else:
+        assert transitions == ["sdk_entered", "response_received"]
+    assert agent._api_request_budget_terminal_failure == {
+        "reason": "lifecycle_ack_denied",
+        "transition": expected_transition,
+        "acknowledged": False,
+    }
+    assert "private prompt" not in repr(agent._api_request_budget_terminal_failure)
+
