+"""Typed, terminal guard for provider requests immediately before dispatch.
+
+This module is intentionally separate from observational plugin hooks. A
+request-budget veto is control flow: it must never be swallowed as an observer
+failure or retried as a provider error.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from dataclasses import dataclass
+from typing import Any, Callable, Mapping
+
+
+@dataclass(frozen=True, slots=True)
+class ApiRequestBudgetView:
+    """Resolved provider identity and a canonical snapshot of final request."""
+
+    provider: str
+    model: str
+    api_mode: str
+    base_url: str | None
+    payload_json: str
+    payload_sha256: str
+    payload_utf8_bytes: int
+
+
+class ApiRequestBudgetVeto(BaseException):
+    """Terminal local rejection; deliberately bypasses generic retry handlers."""
+
+    def __init__(self, *, code: str = "request_budget_exceeded") -> None:
+        super().__init__(code)
+        self.code = code
+
+
+ApiRequestBudgetGuard = Callable[[ApiRequestBudgetView], bool]
+
+
+def _json_snapshot(value: Any) -> Any:
+    if value is None or isinstance(value, (str, bool, int)):
+        return value
+    if isinstance(value, float):
+        if not (value == value and abs(value) != float("inf")):
+            raise ValueError("non-finite request number")
+        return value
+    if isinstance(value, list):
+        return [_json_snapshot(item) for item in value]
+    if isinstance(value, tuple):
+        return [_json_snapshot(item) for item in value]
+    if isinstance(value, Mapping):
+        if any(not isinstance(key, str) for key in value):
+            raise ValueError("request object keys must be strings")
+        return {key: _json_snapshot(item) for key, item in value.items()}
+    raise ValueError("request contains an unsupported value")
+
+
+def build_api_request_budget_view(
+    *,
+    provider: Any,
+    model: Any,
+    api_mode: Any,
+    base_url: Any,
+    request: Any,
+) -> ApiRequestBudgetView:
+    """Build a bounded JSON view of the effective provider request.
+
+    `timeout` and `http_client` are SDK transport controls rather than model
+    input. Every other request field is retained; unsupported values reject.
+    """
+    if not all(isinstance(value, str) and value.strip() for value in (provider, model, api_mode)):
+        raise ValueError("resolved provider, model, and API mode are required")
+    if base_url is not None and not isinstance(base_url, str):
+        raise ValueError("resolved base URL must be a string or null")
+    if not isinstance(request, Mapping):
+        raise ValueError("provider request must be an object")
+    body = {key: value for key, value in request.items() if key not in {"timeout", "http_client"}}
+    snapshot = _json_snapshot(body)
+    payload_json = json.dumps(
+        snapshot,
+        ensure_ascii=False,
+        allow_nan=False,
+        sort_keys=True,
+        separators=(",", ":"),
+    )
+    payload_bytes = payload_json.encode("utf-8")
+    return ApiRequestBudgetView(
+        provider=provider.strip(),
+        model=model.strip(),
+        api_mode=api_mode.strip(),
+        base_url=base_url,
+        payload_json=payload_json,
+        payload_sha256=hashlib.sha256(payload_bytes).hexdigest(),
+        payload_utf8_bytes=len(payload_bytes),
+    )
+
+
+def enforce_api_request_budget(agent: Any, request: Any) -> None:
+    """Run the opt-in turn guard. Any unknown result fails closed."""
+    guard = getattr(agent, "api_request_budget_guard", None)
+    if guard is None:
+        return
+    if not callable(guard):
+        raise ApiRequestBudgetVeto(code="request_budget_guard_invalid")
+    try:
+        view = build_api_request_budget_view(
+            provider=getattr(agent, "provider", None),
+            model=request.get("model") if isinstance(request, Mapping) else None,
+            api_mode=getattr(agent, "api_mode", None),
+            base_url=getattr(agent, "base_url", None),
+            request=request,
+        )
+        allowed = guard(view)
+    except ApiRequestBudgetVeto:
+        raise
+    except Exception as exc:
+        raise ApiRequestBudgetVeto(code="request_budget_guard_error") from exc
+    if allowed is not True:
+        raise ApiRequestBudgetVeto()
