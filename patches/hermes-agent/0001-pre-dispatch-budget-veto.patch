+    agent.api_request_budget_guard = lambda _view: True
+    agent.reasoning_config = {"enabled": True, "effort": "medium"}
+    prior = {
+        "role": "assistant",
+        "content": "I will inspect the graph.",
+        "codex_reasoning_items": [
+            {"type": "reasoning", "encrypted_content": "opaque-provider-state"}
+        ],
+        "codex_message_items": [
+            {
+                "type": "message",
+                "id": "msg_assistant_1",
+                "phase": "commentary",
+                "role": "assistant",
+                "status": "completed",
+                "content": [{"type": "output_text", "text": "I will inspect the graph."}],
+            }
+        ],
+        "tool_calls": [
+            {
+                "id": "call_1",
+                "type": "function",
+                "function": {"name": "expand_graph", "arguments": "{}"},
+            }
+        ],
+    }
+    messages = [
+        {"role": "system", "content": "Use graph tools."},
+        prior,
+        {"role": "tool", "tool_call_id": "call_1", "content": "Found node A."},
+        {"role": "user", "content": "Continue."},
+    ]
+
+    request = agent._build_api_kwargs(messages)
+
+    assert request["include"] == []
+    assert "opaque-provider-state" not in repr(request)
+    assert all(item.get("type") != "reasoning" for item in request["input"] if isinstance(item, dict))
+    assert any(
+        item.get("type") == "message"
+        and item.get("role") == "assistant"
+        and item.get("id") == "msg_assistant_1"
+        and item.get("phase") == "commentary"
+        for item in request["input"]
+    )
+    assert any(item.get("type") == "function_call" for item in request["input"])
+    assert any(
+        item.get("type") == "function_call_output" and item.get("output") == "Found node A."
+        for item in request["input"]
+    )
+    assert any(
+        item.get("role") == "user" and item.get("content") == "Continue."
+        for item in request["input"]
+    )
+
+    response = SimpleNamespace(
+        content="Visible answer",
+        reasoning=None,
+        reasoning_content=None,
+        reasoning_details=None,
+        codex_reasoning_items=[
+            {"type": "reasoning", "encrypted_content": "opaque-response-state"}
+        ],
+        codex_message_items=[
+            {"type": "message", "role": "assistant", "content":[{"type":"output_text","text":"Visible answer"}]}
+        ],
+        tool_calls=None,
+    )
+    stored = agent._build_assistant_message(response, "stop")
+    assert "codex_reasoning_items" not in stored
+    assert stored["codex_message_items"] == response.codex_message_items
