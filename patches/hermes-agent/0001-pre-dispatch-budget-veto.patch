+                except Exception:
+                    logger.exception("Could not persist the conversation after a local request-budget veto")
+                return {
+                    "final_response": (
+                        "The current provider request was denied before dispatch by the local request-budget guard. "
+                        "Earlier provider attempts may have occurred."
+                    ),
+                    "messages": messages,
+                    "api_calls": api_call_count,
+                    "api_request_id": api_request_id,
+                    "completed": False,
+                    "failed": True,
+                    "failure_code": veto.code,
+                    "failure_reason": "request_budget_veto",
