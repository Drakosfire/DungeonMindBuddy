+def test_guarded_responses_builder_preserves_visible_tool_history_without_opaque_reasoning(
+    agent_factory,
+):
+    from unittest.mock import patch
+
+    with patch("run_agent.OpenAI"):
+        agent = agent_factory(base_url="https://api.openai.com/v1", model="gpt-6-luna")
