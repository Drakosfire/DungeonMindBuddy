# syntax=docker/dockerfile:1.7
# Reproducible build inputs: locked npm/uv dependencies, exact source pins, and
# digest-pinned language base images. Update the digest only with a reviewed
# runtime patch; do not replace these references with floating tags.

FROM node:22.23.0-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS ui-build
WORKDIR /build/apps/live-control-ui
COPY apps/live-control-ui/package.json apps/live-control-ui/package-lock.json ./
RUN npm ci
COPY apps/live-control-ui/ ./
# The editor module imports this synthetic fixture during TypeScript compilation.
COPY tests/fixtures/statblocks/v1/candidate-response.json /build/tests/fixtures/statblocks/v1/candidate-response.json
RUN npm run build

FROM ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff AS uv-tool

FROM python:3.13.17-slim-trixie@sha256:d98cc29d3266e535dd9da1099688d9cb3ca4753813571e071763d17725460962 AS dependencies
ARG DEBIAN_SNAPSHOT=20261026
WORKDIR /app
COPY --from=uv-tool /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/* \
    && printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/%s/ trixie main\ndeb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/%s/ trixie-security main\n' \
        "$DEBIAN_SNAPSHOT" "$DEBIAN_SNAPSHOT" > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install --yes --no-install-recommends ca-certificates git build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY --exclude=tests/fixtures/statblocks/v1/candidate-response.json . /app/
RUN python scripts/prepare_patched_hermes.py \
    && uv sync --locked --no-dev --no-editable
COPY --from=ui-build /build/apps/live-control-ui/dist /app/apps/live-control-ui/dist

FROM python:3.13.17-slim-trixie@sha256:d98cc29d3266e535dd9da1099688d9cb3ca4753813571e071763d17725460962 AS api
ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DMB_DEPLOYMENT_ENVIRONMENT=production \
    DMB_AUTH_MODE=hosted_dms
WORKDIR /app
RUN groupadd --gid 10001 buddy \
    && useradd --uid 10001 --gid buddy --home-dir /nonexistent --shell /usr/sbin/nologin buddy
COPY --from=dependencies --chown=10001:10001 /app /app
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=3)" || exit 1
CMD ["uvicorn", "apps.live_control_server.main:app", "--host", "0.0.0.0", "--port", "8000"]
