# Secrets, credentials, and local state never enter the image build context.
.env
.env.*
.aws/
**/.aws/
.git/
.gitignore
.run/
.venv/
**/.venv/
node_modules/
**/node_modules/
dist/
**/dist/
out/
**/out/
corpus/
**/corpus/
tests/
**/tests/
evals/**
!evals/c2_live_prep/
!evals/c2_live_prep/live/
!evals/c2_live_prep/live/schemas/
!evals/c2_live_prep/live/schemas/**
Docs/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/*.pem
**/*.key
**/serviceAccountKey.json
**/secrets.txt
