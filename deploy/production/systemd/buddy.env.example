# Example only. Select the durable roots and inject credentials through the
# operator-approved secret mechanism before installing or starting the unit.
DMB_DEPLOYMENT_ENVIRONMENT=production
DMB_AUTH_MODE=hosted_dms
DUNGEONMIND_SERVER_API_ORIGIN=https://<APPROVED_DMS_API_ORIGIN>
AUTH_TRUSTED_FRONTEND_ORIGINS=https://buddy.dungeonmind.net

# Deliberately empty: World access remains unavailable until policy and exact
# production route resolvers are separately reviewed.
DMB_HOSTED_WORLD_ACCESS_JSON=

# Replace every placeholder through the approved secret mechanism.
DUNGEONBUDDY_APPLICATION_STATE_DATABASE_URL=postgresql://<BUDDY_ROLE>:<SECRET>@<DEDICATED_HOST>:5432/<BUDDY_DATABASE>
DUNGEONMIND_WORLD_GRAPH_AUTHORITY_DATABASE_URL=postgresql://<WORLD_GRAPH_ROLE>:<SECRET>@<DEDICATED_HOST>:5432/<WORLD_GRAPH_DATABASE>
DUNGEONMIND_WORLD_GRAPH_AUTHORITY=dungeonmind

# Replace these with existing, non-overlapping host directories outside release trees.
DMB_MANAGED_WORLD_DATA_ROOT=/srv/REPLACE_WITH_BUDDY_DATA_ROOT/managed
DMB_ARTIFACT_DATA_ROOT=/srv/REPLACE_WITH_BUDDY_DATA_ROOT/artifacts
DUNGEONMIND_LIVE_SESSION_DIR=/srv/REPLACE_WITH_BUDDY_DATA_ROOT/sessions
DUNGEONMIND_WORLD_GRAPH_ROOT=/srv/REPLACE_WITH_WORLDGRAPH_ROOT
DUNGEONMIND_RECAP_SOURCE_CONTENT_ROOT=recaps
