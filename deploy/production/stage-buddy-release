#!/usr/bin/env bash
# Operator-only staging of an approved image-only release.
set -euo pipefail
umask 077

fail() { printf 'Buddy stage: %s\n' "$*" >&2; exit 1; }

[[ $# == 5 || $# == 6 ]] || fail "expected revision, registry digest, image ID, rollback revision, rollback image ID and optional guest-graph mode"
mode=${6:-default}
[[ "$mode" == default || "$mode" == guest-graph ]] || fail "invalid staging mode"
guest_config='review=0;page=0;home='
if [[ "$mode" == guest-graph ]]; then guest_config="$guest_config;graph=1"; fi
revision=$1
digest=$2
candidate_id=$3
rollback_revision=$4
rollback_id=$5
for sha in "$revision" "$rollback_revision"; do
  [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || fail "expected exact source revisions"
done
for hash in "$digest" "$candidate_id" "$rollback_id"; do
  [[ "$hash" =~ ^sha256:[0-9a-f]{64}$ ]] || fail "expected exact SHA-256 digests and image IDs"
done
[[ "$revision" != "$rollback_revision" && "$candidate_id" != "$rollback_id" ]] ||
  fail "candidate and rollback must be distinct"

readonly config_dir=/etc/buddy-deploy
candidate_tag="dungeonmindbuddy:$revision"
rollback_tag="dungeonmindbuddy:$rollback_revision"
ref="ghcr.io/drakosfire/dungeonmindbuddy@$digest"
record="$config_dir/releases/$revision.conf"

exec 9>/run/lock/buddy-production-deploy.lock
flock -n 9 || fail "another Buddy deploy is active"

trusted() {
  local owner mode
  [[ ! -L "$1" ]] || fail "symlink in deployment policy: $1"
  read -r owner mode < <(stat -c '%u %a' -- "$1")
  [[ "$owner" == 0 ]] && (( (8#$mode & 8#022) == 0 )) ||
    fail "deployment policy is not controlled by root: $1"
}
for dir in "$config_dir" "$config_dir/releases"; do
  [[ -d "$dir" ]] || fail "missing policy directory: $dir"
  trusted "$dir"
done

tmp=$(mktemp "$config_dir/releases/.stage.XXXXXX")
trap 'rm -f -- "$tmp"' EXIT
printf 'candidate_tag=%s\ncandidate_id=%s\nrollback_tag=%s\nrollback_id=%s\nrollback_revision=%s\nregistry_digest=%s\n' \
  "$candidate_tag" "$candidate_id" "$rollback_tag" "$rollback_id" "$rollback_revision" "$digest" > "$tmp"
if [[ -e "$record" || -L "$record" ]]; then
  [[ -f "$record" ]] || fail "release policy is not a regular file"
  trusted "$record"
  cmp -s "$tmp" "$record" || fail "existing release policy differs from the requested approval"
fi

identity='{{.Id}} {{index .Config.Labels "org.opencontainers.image.revision"}}'
[[ "$(docker image inspect --format "$identity" "$rollback_tag")" == "$rollback_id $rollback_revision" ]] ||
  fail "rollback image does not match the approved identity"
docker pull --platform linux/amd64 "$ref"
candidate_identity="$identity {{.Os}}/{{.Architecture}} {{index .Config.Labels \"org.dungeonmindbuddy.guest-build\"}}"
[[ "$(docker image inspect --format "$candidate_identity" "$ref")" == "$candidate_id $revision linux/amd64 $guest_config" ]] ||
  fail "registry image does not match the approved release identity"

existing=$(docker image ls --filter "reference=$candidate_tag" --format '{{.Repository}}:{{.Tag}}')
if [[ -z "$existing" ]]; then
  docker image tag "$ref" "$candidate_tag"
fi
[[ "$(docker image inspect --format "$identity" "$candidate_tag")" == "$candidate_id $revision" ]] ||
  fail "candidate tag does not match the approved image"
if [[ ! -e "$record" ]]; then
  ln -T -- "$tmp" "$record"
fi
printf 'BUDDY_STAGED %s %s %s\n' "$revision" "$candidate_id" "$digest"
