#!/usr/bin/env bash
# Operator-only staging of an approved image-only release.
set -euo pipefail
umask 077

fail() { printf 'Buddy stage: %s\n' "$*" >&2; exit 1; }

[[ $# == 5 || $# == 6 || $# == 7 ]] || fail "expected release pins, optional guest mode and optional document template digest"
mode=${6:-default}
[[ "$mode" == default || "$mode" == guest-graph || "$mode" == guest-graph-serving || "$mode" == guest-build || "$mode" == guest-build-serving || "$mode" == guest-build-documents-serving ]] || fail "invalid staging mode"
[[ ( "$mode" == guest-build-documents-serving && $# == 7 && "$7" =~ ^[0-9a-f]{64}$ ) || ( "$mode" != guest-build-documents-serving && $# != 7 ) ]] || fail "invalid guest document template digest"
guest_config='review=0;page=0;home='
if [[ "$mode" != default ]]; then guest_config="$guest_config;graph=1"; fi
if [[ "$mode" == guest-build || "$mode" == guest-build-serving || "$mode" == guest-build-documents-serving ]]; then guest_config="$guest_config;build=1"; fi
revision=$1
digest=$2
candidate_id=$3
rollback_revision=$4
rollback_id=$5
for sha in "$revision" "$rollback_revision"; do
  [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || fail "expected exact source revisions"
done
for hash in "$digest" "$candidate_id" "$rollback_id"; do
  [[ "$hash" =~ ^sha256:[0-9a-f]{64}$ ]] || fail "expected exact SHA-256 digests and image IDs"
done
[[ "$revision" != "$rollback_revision" && "$candidate_id" != "$rollback_id" ]] ||
  fail "candidate and rollback must be distinct"

readonly config_dir=/etc/buddy-deploy
probe_name=
cleanup_probe() {
  [[ -n "$probe_name" ]] || return 0
  if [[ "$(timeout 5s docker inspect --format '{{index .Config.Labels "org.dungeonmindbuddy.stage-probe"}}' "$probe_name" 2>/dev/null || true)" == "$probe_name" ]]; then
    timeout 5s docker rm -f "$probe_name" >/dev/null 2>&1 || true
  fi
}
candidate_tag="dungeonmindbuddy:$revision"
rollback_tag="dungeonmindbuddy:$rollback_revision"
ref="ghcr.io/drakosfire/dungeonmindbuddy@$digest"
record="$config_dir/releases/$revision.conf"

exec 9>/run/lock/buddy-production-deploy.lock
flock -n 9 || fail "another Buddy deploy is active"

trusted() {
  local owner mode
  [[ ! -L "$1" ]] || fail "symlink in deployment policy: $1"
  read -r owner mode < <(stat -c '%u %a' -- "$1")
  [[ "$owner" == 0 ]] && (( (8#$mode & 8#022) == 0 )) ||
    fail "deployment policy is not controlled by root: $1"
}
for dir in "$config_dir" "$config_dir/releases"; do
  [[ -d "$dir" ]] || fail "missing policy directory: $dir"
  trusted "$dir"
done

# The selected baseline is operator-owned policy, not a request parameter.
# Freeze it in the immutable release record so later edits cannot retarget it.
if [[ "$mode" != default ]]; then
  guest_policy="$config_dir/guest-graph.conf"
  [[ -f "$guest_policy" ]] || fail "missing guest Graph baseline policy"
  trusted "$guest_policy"
  unset guest_graph_space guest_graph_revision
  # shellcheck source=/dev/null
  source "$guest_policy"
  [[ "${guest_graph_space:-}" =~ ^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$ ]] || fail "invalid guest Graph space"
  [[ "${guest_graph_revision:-}" =~ ^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$ ]] || fail "invalid guest Graph revision"
fi

if [[ "$mode" == guest-build-documents-serving ]]; then
  template="$config_dir/guest-documents-template.json"
  bundles="$config_dir/guest-document-bundles"
  [[ -f "$template" && -d "$bundles" ]] || fail "missing guest document release inputs"
  trusted "$template"
  trusted "$bundles"
  bundle_tmp=$(mktemp "$bundles/.bundle.XXXXXX")
  trap 'cleanup_probe; rm -f -- "$bundle_tmp" "${tmp:-}"' EXIT
  trap 'exit 130' INT TERM
  GUEST_TEMPLATE="$template" GUEST_TEMPLATE_SHA="$7" GUEST_BUNDLE="$bundle_tmp" GUEST_SPACE="$guest_graph_space" GUEST_REVISION="$guest_graph_revision" python3 - <<'PY' || fail "invalid guest document template"
import hashlib, json, os
from pathlib import Path
with Path(os.environ['GUEST_TEMPLATE']).open('rb') as stream:
    source = stream.read(16 * 1024 * 1024 + 1)
if not source or len(source) > 16 * 1024 * 1024:
    raise ValueError('invalid template size')
if hashlib.sha256(source).hexdigest() != os.environ['GUEST_TEMPLATE_SHA']:
    raise ValueError('template digest mismatch')
obj = json.loads(source)
if not isinstance(obj, dict) or set(obj) != {'version', 'documents'} or obj['version'] != 1:
    raise ValueError('invalid template')
docs = obj['documents']
if not isinstance(docs, list) or not 1 <= len(docs) <= 32:
    raise ValueError('invalid document count')
if any(not isinstance(d, dict) or set(d) != {'title', 'markdown'} or not isinstance(d['title'], str)
       or not d['title'].strip() or not isinstance(d['markdown'], str) for d in docs):
    raise ValueError('invalid document')
obj['graph_space'] = os.environ['GUEST_SPACE']
obj['graph_revision'] = os.environ['GUEST_REVISION']
Path(os.environ['GUEST_BUNDLE']).write_text(json.dumps(obj, ensure_ascii=False, sort_keys=True, separators=(',', ':')), encoding='utf-8')
if Path(os.environ['GUEST_BUNDLE']).stat().st_size > 16 * 1024 * 1024:
    raise ValueError('bound bundle exceeds size limit')
PY
  guest_document_sha=$(sha256sum "$bundle_tmp" | cut -d' ' -f1)
  bundle="$bundles/$guest_document_sha.json"
  chmod 644 "$bundle_tmp"
  if [[ -e "$bundle" || -L "$bundle" ]]; then
    [[ -f "$bundle" ]] || fail "guest document bundle is not a regular file"
    trusted "$bundle"
    cmp -s "$bundle_tmp" "$bundle" || fail "guest document bundle differs from its digest"
  else
    ln -T -- "$bundle_tmp" "$bundle"
  fi
fi

tmp=$(mktemp "$config_dir/releases/.stage.XXXXXX")
trap 'cleanup_probe; rm -f -- "$tmp" "${bundle_tmp:-}"' EXIT
printf 'candidate_tag=%s\ncandidate_id=%s\nrollback_tag=%s\nrollback_id=%s\nrollback_revision=%s\nregistry_digest=%s\n' \
  "$candidate_tag" "$candidate_id" "$rollback_tag" "$rollback_id" "$rollback_revision" "$digest" > "$tmp"
if [[ "$mode" != default ]]; then
  printf 'guest_graph_enabled=1\nguest_graph_space=%s\nguest_graph_revision=%s\n' \
    "$guest_graph_space" "$guest_graph_revision" >> "$tmp"
  if [[ "$mode" == guest-build || "$mode" == guest-build-serving || "$mode" == guest-build-documents-serving ]]; then printf 'guest_build_enabled=1\n' >> "$tmp"; fi
  if [[ "$mode" == guest-build-documents-serving ]]; then printf 'guest_document_sha=%s\n' "$guest_document_sha" >> "$tmp"; fi
fi
if [[ -e "$record" || -L "$record" ]]; then
  [[ -f "$record" ]] || fail "release policy is not a regular file"
  trusted "$record"
  cmp -s "$tmp" "$record" || fail "existing release policy differs from the requested approval"
fi

identity='{{.Id}} {{index .Config.Labels "org.opencontainers.image.revision"}}'
[[ "$(docker image inspect --format "$identity" "$rollback_tag")" == "$rollback_id $rollback_revision" ]] ||
  fail "rollback image does not match the approved identity"
docker pull --platform linux/amd64 "$ref"
candidate_identity="$identity {{.Os}}/{{.Architecture}} {{index .Config.Labels \"org.dungeonmindbuddy.guest-build\"}}"
expected_identity="$candidate_id $revision linux/amd64 $guest_config"
if [[ "$mode" != default ]]; then
  candidate_identity="$candidate_identity {{index .Config.Labels \"org.dungeonmindbuddy.serving-parent\"}}"
  if [[ "$mode" == guest-graph-serving || "$mode" == guest-build-serving || "$mode" == guest-build-documents-serving ]]; then
    expected_identity="$expected_identity $rollback_revision"
  else
    expected_identity="$expected_identity <no value>"
  fi
fi
[[ "$(docker image inspect --format "$candidate_identity" "$ref")" == "$expected_identity" ]] ||
  fail "registry image does not match the approved release identity"
if [[ "$mode" == guest-build-documents-serving ]]; then
  probe_name="buddy-doc-seed-probe-${revision:0:12}-${bundle_tmp##*.}"
  timeout --signal=TERM --kill-after=5s 30s docker run --rm --name "$probe_name" \
    --label "org.dungeonmindbuddy.stage-probe=$probe_name" --network=none --read-only \
    --memory=256m --cpus=1 --pids-limit=64 --cap-drop=ALL --security-opt=no-new-privileges \
    --entrypoint python "$ref" -c \
    'from application_state.index_graph.guest_documents import seed_guest_documents; import sys; sys.exit(0 if callable(seed_guest_documents) else 1)' ||
    fail "candidate image lacks guest document seeding"
  cleanup_probe
  probe_name=
fi

existing=$(docker image ls --filter "reference=$candidate_tag" --format '{{.Repository}}:{{.Tag}}')
if [[ -z "$existing" ]]; then
  docker image tag "$ref" "$candidate_tag"
fi
[[ "$(docker image inspect --format "$identity" "$candidate_tag")" == "$candidate_id $revision" ]] ||
  fail "candidate tag does not match the approved image"
if [[ ! -e "$record" ]]; then
  ln -T -- "$tmp" "$record"
fi
printf 'BUDDY_STAGED %s %s %s\n' "$revision" "$candidate_id" "$digest"
