{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fact.schema.json",
  "title": "DungeonBuddy Fact v0.1",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/baseRecord"
    },
    {
      "$ref": "common.schema.json#/$defs/temporalFields"
    }
  ],
  "type": "object",
  "required": [
    "fact_id",
    "subject_entity_id",
    "attribute",
    "value",
    "truth_state",
    "source_authority",
    "evidence_ids"
  ],
  "properties": {
    "fact_id": {
      "$ref": "common.schema.json#/$defs/idString"
    },
    "subject_entity_id": {
      "$ref": "common.schema.json#/$defs/idString"
    },
    "attribute": {
      "$ref": "common.schema.json#/$defs/attribute"
    },
    "value": {
      "$ref": "common.schema.json#/$defs/factValue"
    },
    "truth_state": {
      "$ref": "common.schema.json#/$defs/truthState"
    },
    "source_authority": {
      "$ref": "common.schema.json#/$defs/authorityTier"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/idString"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "derived_from_event_ids": {
      "$ref": "common.schema.json#/$defs/idArray"
    },
    "related_conflict_ids": {
      "$ref": "common.schema.json#/$defs/idArray"
    },
    "manually_overridden": {
      "type": "boolean"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_anchors": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sourceAnchor"
      }
    }
  },
  "unevaluatedProperties": false
}
