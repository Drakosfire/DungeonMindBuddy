{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entity.schema.json",
  "title": "DungeonBuddy Entity v0.1",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/baseRecord"
    },
    {
      "if": {
        "properties": {
          "entity_status": {
            "const": "canonical"
          }
        },
        "required": [
          "entity_status"
        ]
      },
      "then": {
        "required": [
          "canonical_name"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "entity_status": {
            "const": "merged_into_other"
          }
        },
        "required": [
          "entity_status"
        ]
      },
      "then": {
        "required": [
          "merged_into_entity_id"
        ]
      }
    }
  ],
  "type": "object",
  "required": [
    "entity_id",
    "entity_class",
    "display_name",
    "aliases",
    "entity_status",
    "source_mention_ids"
  ],
  "properties": {
    "entity_id": {
      "$ref": "common.schema.json#/$defs/idString"
    },
    "entity_class": {
      "description": "Canonical ontology bucket for world-facing entity identity.",
      "type": "string",
      "enum": [
        "actor",
        "group",
        "place",
        "object",
        "event",
        "concept"
      ]
    },
    "entity_type": {
      "description": "Deprecated legacy alias; retained for migration compatibility.",
      "type": "string",
      "enum": [
        "npc",
        "location",
        "faction",
        "item",
        "other"
      ]
    },
    "entity_kind": {
      "description": "Deprecated legacy alias for entity_class.",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "actor",
        "group",
        "place",
        "object",
        "event",
        "concept",
        null
      ]
    },
    "display_name": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "canonical_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "aliases": {
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "entity_tags": {
      "description": "Legacy tag bucket retained for compatibility. Prefer subtype_facets, narrative_tags, and document_tags.",
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "semantic_facets": {
      "description": "Deprecated alias for subtype_facets.",
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "subtype_facets": {
      "description": "Ontology facets describing what the entity is (deity, festival, guild, doctrine, etc).",
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "narrative_tags": {
      "description": "Story-function tags; usually better attached to claims/events than identity.",
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "document_tags": {
      "description": "Document-structure tags; typically chunk-level metadata.",
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "decision": {
      "type": "string",
      "enum": [
        "entity",
        "exclude"
      ]
    },
    "exclude_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "generic_noun",
        "descriptive_phrase",
        "document_structure",
        "game_mechanic",
        "sentence_fragment",
        "temporal_connector",
        "underspecified_collective",
        null
      ]
    },
    "source_profile": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "worldbuilding",
        "session_recap",
        "npc_dossier",
        "item_card",
        "encounter_table",
        "cultural_event_doc",
        null
      ]
    },
    "authority": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "canon_reference",
        "planning_note",
        "play_record",
        "rumor_or_belief",
        "mechanic_reference",
        null
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0.0,
      "maximum": 1.0
    },
    "span_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "extraction_method": {
      "description": "How this entity was extracted: llm or heuristic fallback.",
      "type": "string",
      "enum": [
        "llm",
        "heuristic"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "doc_id": {
          "type": "string"
        },
        "chunk_id": {
          "type": "string"
        },
        "section_path": {
          "$ref": "common.schema.json#/$defs/stringArray"
        }
      },
      "required": [
        "doc_id",
        "chunk_id",
        "section_path"
      ],
      "additionalProperties": false
    },
    "entity_status": {
      "type": "string",
      "enum": [
        "provisional",
        "canonical",
        "merged_into_other",
        "ambiguous"
      ]
    },
    "merged_into_entity_id": {
      "$ref": "common.schema.json#/$defs/nullableId"
    },
    "source_mention_ids": {
      "$ref": "common.schema.json#/$defs/idArray"
    },
    "review_state": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "unreviewed",
        "reviewed",
        "approved",
        null
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "unevaluatedProperties": false
}
