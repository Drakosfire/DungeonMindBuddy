{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan_view.schema.json",
  "title": "C2 L5 Plan View v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "campaign_id",
    "session",
    "authoritative",
    "generated_at",
    "derived_from",
    "timeline"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1\\.\\d+$"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "session": {
      "type": "integer",
      "minimum": 1
    },
    "authoritative": {
      "const": false
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "status",
          "summary",
          "refs",
          "state_links"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "projected",
              "active",
              "played",
              "skipped",
              "blocked",
              "unknown"
            ]
          },
          "time_hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "table_ready_prompt": {
            "type": [
              "string",
              "null"
            ]
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "target_type",
                "target_id",
                "label",
                "source_status"
              ],
              "properties": {
                "target_type": {
                  "type": "string",
                  "enum": [
                    "event",
                    "roll_table",
                    "npc",
                    "location",
                    "runbook_section",
                    "job",
                    "open_loop",
                    "source_packet"
                  ]
                },
                "target_id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "source_status": {
                  "type": "string",
                  "enum": [
                    "derived",
                    "authoritative",
                    "live_only",
                    "stale",
                    "missing",
                    "unknown"
                  ]
                },
                "role": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "state_links": {
            "type": "object",
            "required": [
              "event_ids",
              "job_ids",
              "open_loop_ids"
            ],
            "properties": {
              "event_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "job_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "open_loop_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
