#!/usr/bin/env bash
# ./run — local dogfood launcher for DungeonMindServer + DungeonBuddy + UI
#
# Starts three processes from a Buddy checkout:
#   1. DungeonMindServer  (sibling repo, default :7860)
#   2. DungeonBuddy API   (live_control_server, :8000)
#   3. DungeonBuddy UI    (live-control-ui Vite, :5173)
#
# Env overrides:
#   DUNGEONMIND_SERVER_ROOT   path to DungeonMindServer (default: ../DungeonMindServer)
#   DUNGEONMIND_SERVER_PORT   default 7860
#   BUDDY_API_PORT            default 8000
#   BUDDY_UI_PORT             default 5173
#   RUN_NO_RELOAD=1           disable --reload / Vite HMR extras
#   DMB_AGENT_GRAPH_LOCAL_PROFILE  opt in to an owner-private local Graph profile
#   DMB_MANAGED_WORLD_DATA_ROOT    existing stable managed-World root for that profile
#
# Ctrl+C stops everything started by this script.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

DMS_ROOT="${DUNGEONMIND_SERVER_ROOT:-$ROOT/../DungeonMindServer}"
DMS_PORT="${DUNGEONMIND_SERVER_PORT:-7860}"
API_PORT="${BUDDY_API_PORT:-8000}"
if [[ -n "${DMB_AGENT_GRAPH_LOCAL_PROFILE:-}" ]]; then
  UI_PORT="${BUDDY_UI_PORT:-5202}"
else
  UI_PORT="${BUDDY_UI_PORT:-5173}"
fi

RUN_DIR="$ROOT/.run"
mkdir -p "$RUN_DIR"

PIDS=()
OWNED_PIDS=()
OWNED_STARTS=()

log() { printf '[run] %s\n' "$*"; }
die() { printf '[run] ERROR: %s\n' "$*" >&2; exit 1; }

port_listening() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -ltn 2>/dev/null | grep -E ":${port}\\b" >/dev/null
  else
    lsof -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1
  fi
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

# Process birth identities distinguish our children from a reused PID. Keep
# descendants after reparenting; never infer ownership from a port or group.
process_identity() {
  local line rest
  local fields=()
  if [[ ! -d /proc/$$ ]]; then
    # Preserve non-Linux launcher support using ps's process birth timestamp.
    local observed_pid state
    read -r observed_pid PROCESS_PARENT state PROCESS_START <<<"$(ps -p "$1" -o pid=,ppid=,stat=,lstart=)"
    [[ "$observed_pid" == "$1" && -n "$PROCESS_START" && "$state" != Z* ]]
    return
  fi
  [[ -r "/proc/$1/stat" ]] || return 1
  IFS= read -r line <"/proc/$1/stat" || return 1
  rest="${line##*) }"
  read -r -a fields <<<"$rest"
  [[ ${#fields[@]} -gt 19 && "${fields[0]}" != "Z" ]] || return 1
  PROCESS_PARENT="${fields[1]}"
  PROCESS_START="${fields[19]}"
}

remember_started_process() {
  local pid="$1"
  PIDS+=("$pid")
  if process_identity "$pid" && [[ "$PROCESS_PARENT" == "$$" ]]; then
    OWNED_PIDS+=("$pid")
    OWNED_STARTS+=("$PROCESS_START")
  fi
}

capture_owned_descendants() {
  local snapshot pid parent i j known
  snapshot="$(ps -eo pid=,ppid=)" || return 0
  # Appending children while walking this list also discovers grandchildren.
  for ((i = 0; i < ${#OWNED_PIDS[@]}; i++)); do
    process_identity "${OWNED_PIDS[i]}" || continue
    [[ "$PROCESS_START" == "${OWNED_STARTS[i]}" ]] || continue
    while read -r pid parent; do
      [[ "$parent" == "${OWNED_PIDS[i]}" ]] || continue
      known=0
      for ((j = 0; j < ${#OWNED_PIDS[@]}; j++)); do
        [[ "${OWNED_PIDS[j]}" == "$pid" ]] && known=1 && break
      done
      [[ "$known" == "0" ]] || continue
      process_identity "$pid" || continue
      [[ "$PROCESS_PARENT" == "$parent" ]] || continue
      OWNED_PIDS+=("$pid")
      OWNED_STARTS+=("$PROCESS_START")
    done <<<"$snapshot"
  done
}

signal_owned_processes() {
  local signal="$1" i
  # Descendants first, while their parents can still reap them.
  for ((i = ${#OWNED_PIDS[@]} - 1; i >= 0; i--)); do
    process_identity "${OWNED_PIDS[i]}" || continue
    [[ "$PROCESS_START" == "${OWNED_STARTS[i]}" ]] || continue
    kill "-$signal" "${OWNED_PIDS[i]}" 2>/dev/null || true
  done
}

cleanup() {
  trap - EXIT INT TERM
  log "stopping services…"
  capture_owned_descendants
  signal_owned_processes TERM
  sleep 1
  signal_owned_processes KILL
  rm -f "$RUN_DIR"/*.pid
  log "stopped"
}

trap cleanup EXIT
trap 'exit 0' INT TERM

require_cmd uv
require_cmd npm

[[ -d "$DMS_ROOT" ]] || die "DungeonMindServer not found at $DMS_ROOT (set DUNGEONMIND_SERVER_ROOT)"
[[ -f "$ROOT/apps/live_control_server/main.py" ]] || die "not a DungeonMindBuddy checkout: $ROOT"
[[ -d "$ROOT/apps/live-control-ui" ]] || die "missing apps/live-control-ui"

if [[ -n "${DMB_AGENT_GRAPH_LOCAL_PROFILE:-}" ]]; then
  [[ -n "${DUNGEONMIND_SERVER_ROOT:-}" ]] || die "local Graph profile requires explicit DUNGEONMIND_SERVER_ROOT"
  [[ -n "${DMB_MANAGED_WORLD_DATA_ROOT:-}" ]] || die "local Graph profile requires DMB_MANAGED_WORLD_DATA_ROOT"
  # An occupied service port may be a different checkout or profile. Do not
  # kill it or claim that this launcher's code/configuration is serving it.
  if port_listening "$DMS_PORT"; then
    die "local Graph profile cannot verify an existing DungeonMindServer listener; stop its owning launcher first"
  fi
  if port_listening "$API_PORT" || port_listening "$UI_PORT"; then
    die "local Graph profile cannot verify an existing API/UI listener; stop its owning launcher first"
  fi
  profile_args=(
    --ui-port "$UI_PORT" --api-port "$API_PORT" --server-root "$DMS_ROOT"
  )
  if [[ -n "${DMB_AGENT_GRAPH_REQUIRED_WORLD_ID:-}" ]]; then
    profile_args+=(--require-world "$DMB_AGENT_GRAPH_REQUIRED_WORLD_ID")
  fi
  if ! uv run python scripts/preflight_local_graph_profile.py "${profile_args[@]}"; then
    die "local Graph access is not configured; no service was started"
  fi
fi

start_dms() {
  if port_listening "$DMS_PORT"; then
    log "DungeonMindServer already listening on :$DMS_PORT — leaving it alone (revision unverified)"
    return 0
  fi
  log "starting DungeonMindServer in $DMS_ROOT on :$DMS_PORT"
  (
    cd "$DMS_ROOT"
    # Prefer the repo's uv-managed env; fall back to python if needed.
    if [[ -f dev_server.py ]]; then
      exec uv run python dev_server.py
    else
      exec uv run uvicorn app:app --host 127.0.0.1 --port "$DMS_PORT" --reload
    fi
  ) >"$RUN_DIR/dungeonmind-server.log" 2>&1 &
  local pid=$!
  remember_started_process "$pid"
  echo "$pid" >"$RUN_DIR/dungeonmind-server.pid"
}

start_buddy_api() {
  if port_listening "$API_PORT"; then
    log "DungeonBuddy API already listening on :$API_PORT — leaving it alone"
    return 0
  fi
  log "starting DungeonBuddy API on :$API_PORT"
  local reload_args=(--reload)
  if [[ "${RUN_NO_RELOAD:-}" == "1" ]]; then
    reload_args=()
  fi
  (
    cd "$ROOT"
    exec uv run uvicorn apps.live_control_server.main:app \
      --host 127.0.0.1 \
      --port "$API_PORT" \
      "${reload_args[@]}"
  ) >"$RUN_DIR/buddy-api.log" 2>&1 &
  local pid=$!
  remember_started_process "$pid"
  echo "$pid" >"$RUN_DIR/buddy-api.pid"
}

start_buddy_ui() {
  if port_listening "$UI_PORT"; then
    log "DungeonBuddy UI already listening on :$UI_PORT — leaving it alone"
    return 0
  fi
  log "starting DungeonBuddy UI on :$UI_PORT"
  if [[ ! -d "$ROOT/apps/live-control-ui/node_modules" ]]; then
    log "installing UI deps (npm ci)…"
    npm --prefix "$ROOT/apps/live-control-ui" ci
  fi
  (
    cd "$ROOT/apps/live-control-ui"
    # Polling avoids ENOSPC/inotify watch exhaustion on busy Linux hosts.
    export CHOKIDAR_USEPOLLING="${CHOKIDAR_USEPOLLING:-1}"
    export CHOKIDAR_INTERVAL="${CHOKIDAR_INTERVAL:-2000}"
    export VITE_LIVE_API_PROXY_TARGET="${VITE_LIVE_API_PROXY_TARGET:-http://127.0.0.1:${API_PORT}}"
    exec npm run dev -- --host 127.0.0.1 --port "$UI_PORT"
  ) >"$RUN_DIR/buddy-ui.log" 2>&1 &
  local pid=$!
  remember_started_process "$pid"
  echo "$pid" >"$RUN_DIR/buddy-ui.pid"
}

wait_http() {
  local url="$1"
  local label="$2"
  local tries="${3:-40}"
  local i
  for ((i = 1; i <= tries; i++)); do
    capture_owned_descendants
    if curl -fsS -o /dev/null "$url" 2>/dev/null; then
      log "$label ready ($url)"
      return 0
    fi
    sleep 0.5
  done
  log "WARNING: $label did not become ready at $url (see .run/*.log)"
  return 1
}

log "Buddy root: $ROOT"
log "DungeonMindServer: $DMS_ROOT"

start_dms
start_buddy_api
start_buddy_ui

if [[ -n "${DMB_AGENT_GRAPH_LOCAL_PROFILE:-}" ]]; then
  wait_http "http://127.0.0.1:${DMS_PORT}/docs" "DungeonMindServer API health" 60 || die "DungeonMindServer API health unavailable"
  wait_http "http://127.0.0.1:${API_PORT}/docs" "DungeonBuddy API health" 60 || die "DungeonBuddy API health unavailable"
  wait_http "http://127.0.0.1:${UI_PORT}/" "DungeonBuddy UI" 60 || die "DungeonBuddy UI unavailable"
else
  wait_http "http://127.0.0.1:${DMS_PORT}/docs" "DungeonMindServer" 60 || true
  wait_http "http://127.0.0.1:${API_PORT}/docs" "DungeonBuddy API" 60 || true
  wait_http "http://127.0.0.1:${UI_PORT}/" "DungeonBuddy UI" 60 || true
fi

stack_status="local stack up"
if [[ -n "${DMB_AGENT_GRAPH_LOCAL_PROFILE:-}" ]]; then
  stack_status="local stack health checks passed"
fi
cat <<EOF

[run] $stack_status

  DungeonMindServer  http://127.0.0.1:${DMS_PORT}/docs
  DungeonBuddy API   http://127.0.0.1:${API_PORT}/docs
  DungeonBuddy UI    http://127.0.0.1:${UI_PORT}/

  logs: $RUN_DIR/*.log

EOF

if [[ -n "${DMB_AGENT_GRAPH_LOCAL_PROFILE:-}" ]]; then
  log "local Graph access configured; Graph-backed answer not yet accepted by this launch"
fi

if [[ ${#PIDS[@]} -eq 0 ]]; then
  log "nothing new started (all ports already occupied); exiting"
  trap - EXIT INT TERM
  exit 0
fi

log "Ctrl+C to stop processes started by this script"
# Keep the launcher alive while children run.
while true; do
  capture_owned_descendants
  for pid in "${PIDS[@]:-}"; do
    if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
      die "process $pid exited early — check $RUN_DIR/*.log"
    fi
  done
  sleep 2
done
