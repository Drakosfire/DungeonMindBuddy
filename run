#!/usr/bin/env bash
# ./run — local dogfood launcher for DungeonMindServer + DungeonBuddy + UI
#
# Starts three processes from a Buddy checkout:
#   1. DungeonMindServer  (sibling repo, default :7860)
#   2. DungeonBuddy API   (live_control_server, :8000)
#   3. DungeonBuddy UI    (live-control-ui Vite, :5173)
#
# Env overrides:
#   DUNGEONMIND_SERVER_ROOT   path to DungeonMindServer (default: ../DungeonMindServer)
#   DUNGEONMIND_SERVER_PORT   default 7860
#   BUDDY_API_PORT            default 8000
#   BUDDY_UI_PORT             default 5173
#   RUN_NO_RELOAD=1           disable Buddy API reload; DungeonMindServer and Vite keep their defaults
#   DMB_AGENT_GRAPH_LOCAL_PROFILE  opt in to an owner-private local Graph profile
#   DMB_MANAGED_WORLD_DATA_ROOT    existing stable managed-World root for that profile
#
# Ctrl+C stops everything started by this script.

set -euo pipefail

# The local launcher is the explicit local-operator boundary. The API also
# rejects any forwarded request metadata before honoring loopback-local access.
export DMB_DEPLOYMENT_ENVIRONMENT="${DMB_DEPLOYMENT_ENVIRONMENT:-local}"
export DMB_AUTH_MODE="${DMB_AUTH_MODE:-local_operator}"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

source "$ROOT/scripts/local_pdf_ocr_env.sh"
configure_local_pdf_ocr "$ROOT"

DMS_ROOT="${DUNGEONMIND_SERVER_ROOT:-$ROOT/../DungeonMindServer}"
DMS_PORT="${DUNGEONMIND_SERVER_PORT:-7860}"
API_PORT="${BUDDY_API_PORT:-8000}"
if [[ -n "${DMB_AGENT_GRAPH_LOCAL_PROFILE:-}" ]]; then
  UI_PORT="${BUDDY_UI_PORT:-5202}"
else
  UI_PORT="${BUDDY_UI_PORT:-5173}"
fi

log() { printf '[run] %s\n' "$*"; }
die() { printf '[run] ERROR: %s\n' "$*" >&2; exit 1; }

for port in "$DMS_PORT" "$API_PORT" "$UI_PORT"; do
  if [[ ! "$port" =~ ^[1-9][0-9]{0,4}$ ]] || (( port > 65535 )); then
    die "service ports must be decimal integers from 1 to 65535 (received: $port)"
  fi
done
if [[ "$DMS_PORT" == "$API_PORT" || "$DMS_PORT" == "$UI_PORT" || "$API_PORT" == "$UI_PORT" ]]; then
  die "DungeonMindServer, Buddy API, and Buddy UI require distinct ports"
fi

RUN_DIR="$ROOT/.run"
mkdir -p "$RUN_DIR"
command -v flock >/dev/null 2>&1 || die "missing required command: flock"
exec {launch_lock}>>"$RUN_DIR/launcher.lock"
flock -n "$launch_lock" || die "another launcher owns $RUN_DIR; stop it before starting another from this checkout"

PIDS=()
PID_FILES=()
BUDDY_UI_PID=""

port_listening() {
  local port="$1"
  local output status
  if command -v ss >/dev/null 2>&1; then
    output=$(ss -H -ltn "sport = :$port") || die "ss failed while checking port $port"
    [[ -n "$output" ]]
  elif command -v lsof >/dev/null 2>&1; then
    if output=$(lsof -iTCP:"$port" -sTCP:LISTEN 2>&1); then
      return 0
    else
      status=$?
      if [[ "$status" == 1 && -z "$output" ]]; then
        return 1
      fi
      printf '%s\n' "$output" >&2
      die "lsof failed while checking port $port"
    fi
  else
    die "listener detection requires ss or lsof"
  fi
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

cleanup() {
  local pid
  log "stopping services…"
  for pid in "${PIDS[@]:-}"; do
    if [[ -n "$pid" ]]; then
      # The child may still be starting and have no separate group yet.
      kill -- "-$pid" 2>/dev/null || kill -- "$pid" 2>/dev/null || true
    fi
  done
  # Give children a moment; then force if needed.
  sleep 1
  for pid in "${PIDS[@]:-}"; do
    if [[ -n "$pid" ]]; then
      # The child may still be starting and have no separate group yet.
      kill -9 -- "-$pid" 2>/dev/null || kill -9 -- "$pid" 2>/dev/null || true
    fi
  done
  if (( ${#PID_FILES[@]} )); then
    rm -f -- "${PID_FILES[@]}"
  fi
  log "stopped"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

require_cmd setsid
require_cmd python3
require_cmd uv
require_cmd npm
require_cmd curl

[[ -d "$DMS_ROOT" ]] || die "DungeonMindServer not found at $DMS_ROOT (set DUNGEONMIND_SERVER_ROOT)"
[[ -f "$ROOT/apps/live_control_server/main.py" ]] || die "not a DungeonMindBuddy checkout: $ROOT"
[[ -d "$ROOT/apps/live-control-ui" ]] || die "missing apps/live-control-ui"

if [[ -n "${DMB_AGENT_GRAPH_LOCAL_PROFILE:-}" ]]; then
  [[ -n "${DUNGEONMIND_SERVER_ROOT:-}" ]] || die "local Graph profile requires explicit DUNGEONMIND_SERVER_ROOT"
  [[ -n "${DMB_MANAGED_WORLD_DATA_ROOT:-}" ]] || die "local Graph profile requires DMB_MANAGED_WORLD_DATA_ROOT"
  # An occupied service port may be a different checkout or profile. Do not
  # kill it or claim that this launcher's code/configuration is serving it.
  if port_listening "$DMS_PORT"; then
    die "local Graph profile cannot verify an existing DungeonMindServer listener; stop its owning launcher first"
  fi
  if port_listening "$API_PORT" || port_listening "$UI_PORT"; then
    die "local Graph profile cannot verify an existing API/UI listener; stop its owning launcher first"
  fi
  profile_args=(
    --ui-port "$UI_PORT" --api-port "$API_PORT" --server-root "$DMS_ROOT"
  )
  if [[ -n "${DMB_AGENT_GRAPH_REQUIRED_WORLD_ID:-}" ]]; then
    profile_args+=(--require-world "$DMB_AGENT_GRAPH_REQUIRED_WORLD_ID")
  fi
  if ! uv run python scripts/preflight_local_graph_profile.py "${profile_args[@]}"; then
    die "local Graph access is not configured; no service was started"
  fi
fi

start_dms() {
  if port_listening "$DMS_PORT"; then
    log "DungeonMindServer already listening on :$DMS_PORT — leaving it alone (revision unverified)"
    return 0
  fi
  log "starting DungeonMindServer in $DMS_ROOT on :$DMS_PORT"
  (
    cd "$DMS_ROOT"
    # Prefer the repo's uv-managed env; fall back to python if needed.
    if [[ -f dev_server.py ]]; then
      exec setsid uv run python dev_server.py
    else
      exec setsid uv run uvicorn app:app --host 127.0.0.1 --port "$DMS_PORT" --reload
    fi
  ) {launch_lock}>&- > >(python3 "$ROOT/scripts/rotate_launcher_log.py" "$RUN_DIR/dungeonmind-server.log") 2>&1 &
  local pid=$!
  PIDS+=("$pid")
  echo "$pid" >"$RUN_DIR/dungeonmind-server.pid"
  PID_FILES+=("$RUN_DIR/dungeonmind-server.pid")
}

start_buddy_api() {
  if port_listening "$API_PORT"; then
    log "DungeonBuddy API already listening on :$API_PORT — leaving it alone"
    return 0
  fi
  log "starting DungeonBuddy API on :$API_PORT"
  local reload_args=(--reload)
  if [[ "${RUN_NO_RELOAD:-}" == "1" ]]; then
    reload_args=()
  fi
  (
    cd "$ROOT"
    exec setsid uv run uvicorn apps.live_control_server.main:app \
      --host 127.0.0.1 \
      --port "$API_PORT" \
      "${reload_args[@]}"
  ) {launch_lock}>&- > >(python3 "$ROOT/scripts/rotate_launcher_log.py" "$RUN_DIR/buddy-api.log") 2>&1 &
  local pid=$!
  PIDS+=("$pid")
  echo "$pid" >"$RUN_DIR/buddy-api.pid"
  PID_FILES+=("$RUN_DIR/buddy-api.pid")
}

prepare_buddy_ui_dependencies() {
  if port_listening "$UI_PORT"; then
    return 0
  fi
  local ui="$ROOT/apps/live-control-ui"
  local stamp="$ui/node_modules/.buddy-package-lock.sha256"
  local fingerprint
  fingerprint=$(sha256sum "$ui/package-lock.json") || die "cannot fingerprint UI lockfile"
  if [[ -f "$stamp" && "$(<"$stamp")" == "$fingerprint" ]]; then
    return 0
  fi
  log "installing UI deps (npm ci)…"
  rm -f -- "$stamp" || die "cannot invalidate UI dependency stamp"
  npm --prefix "$ui" ci || die "UI dependency installation failed"
  printf '%s\n' "$fingerprint" >"$stamp"
}

start_buddy_ui() {
  if port_listening "$UI_PORT"; then
    log "DungeonBuddy UI already listening on :$UI_PORT — leaving it alone"
    return 0
  fi
  log "starting DungeonBuddy UI on :$UI_PORT"
  (
    cd "$ROOT/apps/live-control-ui"
    # Polling avoids ENOSPC/inotify watch exhaustion on busy Linux hosts.
    export CHOKIDAR_USEPOLLING="${CHOKIDAR_USEPOLLING:-1}"
    export CHOKIDAR_INTERVAL="${CHOKIDAR_INTERVAL:-2000}"
    export VITE_LIVE_API_PROXY_TARGET="${VITE_LIVE_API_PROXY_TARGET:-http://127.0.0.1:${API_PORT}}"
    exec setsid npm run dev -- --host 127.0.0.1 --port "$UI_PORT" --strictPort
  ) {launch_lock}>&- > >(python3 "$ROOT/scripts/rotate_launcher_log.py" "$RUN_DIR/buddy-ui.log") 2>&1 &
  local pid=$!
  PIDS+=("$pid")
  BUDDY_UI_PID="$pid"
  echo "$pid" >"$RUN_DIR/buddy-ui.pid"
  PID_FILES+=("$RUN_DIR/buddy-ui.pid")
}

check_owned_services() {
  local i
  for i in "${!PIDS[@]}"; do
    if ! kill -0 "${PIDS[i]}" 2>/dev/null; then
      die "service exited — check ${PID_FILES[i]%.pid}.log"
    fi
  done
}

wait_http() {
  local url="$1"
  local label="$2"
  local probe_deadline=$((SECONDS + 30))
  while (( SECONDS < probe_deadline && SECONDS < startup_deadline )); do
    check_owned_services
    if curl -fsS --max-time 1 -o /dev/null "$url" 2>/dev/null; then
      check_owned_services
      log "$label ready ($url)"
      return 0
    fi
    sleep 0.5
  done
  log "WARNING: $label did not become ready at $url (see .run/*.log)"
  return 1
}

log "Buddy root: $ROOT"
log "DungeonMindServer: $DMS_ROOT"

prepare_buddy_ui_dependencies
start_dms
start_buddy_api
start_buddy_ui

startup_deadline=$((SECONDS + 90))
stack_status="local stack up"
if [[ -n "${DMB_AGENT_GRAPH_LOCAL_PROFILE:-}" ]]; then
  wait_http "http://127.0.0.1:${DMS_PORT}/docs" "DungeonMindServer API health" || die "DungeonMindServer API health unavailable"
  wait_http "http://127.0.0.1:${API_PORT}/docs" "DungeonBuddy API health" || die "DungeonBuddy API health unavailable"
  wait_http "http://127.0.0.1:${UI_PORT}/" "DungeonBuddy UI" || die "DungeonBuddy UI unavailable"
else
  wait_http "http://127.0.0.1:${DMS_PORT}/docs" "DungeonMindServer" || stack_status="local stack partially ready"
  wait_http "http://127.0.0.1:${API_PORT}/docs" "DungeonBuddy API" || stack_status="local stack partially ready"
  wait_http "http://127.0.0.1:${UI_PORT}/" "DungeonBuddy UI" || {
    stack_status="local stack partially ready"
    [[ -z "${BUDDY_UI_PID:-}" ]] || die "DungeonBuddy UI unavailable — check $RUN_DIR/buddy-ui.log"
  }
fi

if [[ -n "${BUDDY_UI_PID:-}" ]] && ! kill -0 "$BUDDY_UI_PID" 2>/dev/null; then
  die "DungeonBuddy UI exited during startup — check $RUN_DIR/buddy-ui.log"
fi

if [[ -n "${DMB_AGENT_GRAPH_LOCAL_PROFILE:-}" ]]; then
  stack_status="local stack health checks passed"
fi
cat <<EOF

[run] $stack_status

  DungeonMindServer  http://127.0.0.1:${DMS_PORT}/docs
  DungeonBuddy API   http://127.0.0.1:${API_PORT}/docs
  DungeonBuddy UI    http://127.0.0.1:${UI_PORT}/

  logs: $RUN_DIR/*.log

EOF

if [[ -n "${DMB_AGENT_GRAPH_LOCAL_PROFILE:-}" ]]; then
  log "local Graph access configured; Graph-backed answer not yet accepted by this launch"
fi

if [[ ${#PIDS[@]} -eq 0 ]]; then
  log "nothing new started (all ports already occupied); exiting"
  trap - EXIT INT TERM
  exit 0
fi

log "Ctrl+C to stop processes started by this script"
# Keep the launcher alive while children run.
while true; do
  check_owned_services
  sleep 2
done
