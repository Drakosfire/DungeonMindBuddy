evals/**/output/extracted_*.json
evals/**/output/automated_*.json
evals/mirathorn_vertical_slice/output/phase_d_store/
evals/llm_ingestion_slice/output/current/

# NPC recap surface crawl dated runs (keep artifacts/last_*.json for local review)
